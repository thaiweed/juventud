# ─── Django ───────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True only for local development; NEVER True on production server
DEBUG=False

ALLOWED_HOSTS=juventudonline.store,www.juventudonline.store

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=juventud
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ─── Email (MailerSend SMTP) ──────────────────────────────────────────────────
EMAIL_HOST=smtp.mailersend.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ─── Redis / Celery ───────────────────────────────────────────────────────────
# L-3: Redis requires password; update this in docker-compose.yml too
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ─── Payment Providers ────────────────────────────────────────────────────────
PAYMENT_PROVIDER=nowpayments

# NowPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# YooKassa (uncomment when ready)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
