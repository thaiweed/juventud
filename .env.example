# ═════════════════════════════════════════════════════════════════════════════
# Juventud — .env.example
#
# 1. Скопируй этот файл: cp .env.example .env
# 2. Заполни все значения (пустые строки — обязательны к заполнению)
# 3. Никогда не коммить .env в git (он уже в .gitignore)
# ═════════════════════════════════════════════════════════════════════════════


# ─── Django ──────────────────────────────────────────────────────────────────

# Режим отладки. На production ВСЕГДА False.
# True только для локальной разработки.
DEBUG=False

# Секретный ключ Django. Генерация:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Домены, которые Django принимает. Через запятую без пробелов.
ALLOWED_HOSTS=juventudonline.store,www.juventudonline.store


# ─── База данных (PostgreSQL) ─────────────────────────────────────────────────

# Имя базы данных
DB_NAME=juventud

# Пользователь базы данных
DB_USER=

# Пароль пользователя базы данных (используй длинный случайный пароль)
DB_PASSWORD=

# Хост. В Docker всегда "db" (имя сервиса в docker-compose.yml)
DB_HOST=db

# Порт PostgreSQL
DB_PORT=5432


# ─── Redis ────────────────────────────────────────────────────────────────────

# Пароль для Redis (используй длинный случайный пароль).
# Генерация: openssl rand -hex 32
REDIS_PASSWORD=

# URL брокера для Celery. Формат: redis://:ПАРОЛЬ@ХОСТ:ПОРТ/НОМЕР_БД
# В Docker хост всегда "redis" (имя сервиса).
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# URL кэша Django (другая БД Redis, номер 1)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1


# ─── Email (MailerSend SMTP) ──────────────────────────────────────────────────

EMAIL_HOST=smtp.mailersend.net
EMAIL_PORT=587
EMAIL_USE_TLS=True

# SMTP-логин (обычно вида MS_XXXXX@yourdomain.mlsender.net)
EMAIL_HOST_USER=

# SMTP-пароль из личного кабинета MailerSend
EMAIL_HOST_PASSWORD=

# Адрес отправителя. Должен совпадать с верифицированным доменом в MailerSend.
# Например: noreply@juventudonline.store
DEFAULT_FROM_EMAIL=


# ─── Платёжные системы ────────────────────────────────────────────────────────

# Активный провайдер: nowpayments | yookassa
PAYMENT_PROVIDER=nowpayments

# NowPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# YooKassa (раскомментировать когда будешь подключать)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
